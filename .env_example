# Django settings
SECRET_KEY="your-secret-key-here"
DJANGO_SETTINGS_MODULE="speakwise.settings.local"

# Database configuration (PostgreSQL)
DB_NAME="speakwise"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_HOST="localhost"
DB_PORT=5432

# OAuth Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_REDIRECT_URI="http://localhost:8000/api/users/auth/github-callback/"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/users/auth/google-callback/"

# OAuth Library Tweaks
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"

# Email settings (Mailgun)
MAILGUN_API_KEY="your_mailgun_api_key"
MAILGUN_SENDER_DOMAIN="your_mailgun_domain"
DEFAULT_FROM_EMAIL="noreply@yourdomain.com"
SERVER_EMAIL="server@yourdomain.com"

# Redis (for caching and task queue)
REDIS_URL="redis://127.0.0.1:6379/1"
