# Django settings (copy to .env; never commit real values)
SECRET_KEY="your-secret-key-here"
DJANGO_SETTINGS_MODULE="speakwise.settings.local"
DEBUG="True"

# Production hosts (comma-separated). Required in production.
ALLOWED_HOSTS="apis.speak-wise.live,speak-wise.live,www.speak-wise.live"
CSRF_TRUSTED_ORIGINS="https://apis.speak-wise.live,https://speak-wise.live,https://www.speak-wise.live"
CORS_ALLOWED_ORIGINS_EXTRA=""

# Database: prefer DATABASE_URL (DigitalOcean Managed Postgres, Railway).
# Fall back to split vars for Droplet-era envs. Managed PG needs sslmode=require.
DATABASE_URL="postgres://user:password@host:5432/speakwise?sslmode=require"
DB_NAME="speakwise"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_HOST="localhost"
DB_PORT=5432
DB_SSLMODE="require"

# Static/media overrides (optional; defaults to <BASE_DIR>/staticfiles and <BASE_DIR>/media)
STATIC_ROOT=""
MEDIA_ROOT=""

# Object storage for media (DigitalOcean Spaces, S3-compatible).
# When set, uploads go to Spaces instead of ephemeral local disk.
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_ENDPOINT_URL="https://fra1.digitaloceanspaces.com"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_REGION_NAME="fra1"

# OAuth Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_REDIRECT_URI="http://localhost:8000/api/users/auth/github-callback/"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/users/auth/google-callback/"

# OAuth Library Tweaks
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"

# Email settings (Mailgun)
MAILGUN_API_KEY="your_mailgun_api_key"
MAILGUN_SENDER_DOMAIN="your_mailgun_domain"
DEFAULT_FROM_EMAIL="noreply@yourdomain.com"
SERVER_EMAIL="server@yourdomain.com"
